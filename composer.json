{
    "name": "pyramedia/pyramedia-website",
    "description": "PYRAMEDIA - Digital Marketing & Media Agency Website",
    "type": "project",
    "license": "proprietary",
    "keywords": [
        "marketing",
        "media",
        "agency",
        "cms",
        "blog",
        "portfolio"
    ],
    "authors": [
        {
            "name": "PYRAMEDIA Development Team",
            "email": "info@pyramedia.ae"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Pyramedia\\": "src/"
        },
        "files": [
            "config/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pyramedia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "phpcs": "phpcs --standard=PSR12 admin/ php/ config/",
        "phpcbf": "phpcbf --standard=PSR12 admin/ php/ config/"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
