# ========================================
# PYRAMEDIA - Git Ignore
# ========================================

# Data directories
data/
logs/
calendar/

# Environment files
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.code-workspace

# PHP
vendor/
composer.lock
*.cache

# Backup files
*.bak
*.backup
*backup*

# User uploads (if added later)
uploads/
user_uploads/

# Sensitive configuration
config/database.php
config/secret.php

# Generated files
*.map
*.css.map
*.js.map

# Cache
cache/
*.cache

# Test files
tests/coverage/
.phpunit.result.cache
